# Student Information Portal - Environment Configuration Template
# Copy this file to .env and configure with your environment-specific credentials.
# NEVER commit real credentials or secrets to version control.

# Application Server Port
PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=student_portal_db

# JSON Web Token Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed CORS Origins (comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:5000

# Email / SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user_here
SMTP_PASSWORD=your_smtp_password_here
# Alternative: SMTP_PASS=your_smtp_password_here
EMAIL_FROM="Student Portal <noreply@studentportal.local>"
# Alternative: SMTP_FROM="Student Portal <noreply@studentportal.local>"
EMAIL_ENABLED=false

# Frontend Application Base URL (for email links)
FRONTEND_URL=http://localhost:5000

# Web Push Notification (VAPID) Configuration
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@studentportal.local

